{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/manufacturing_capability.schema.json",
  "type": "object",
  "properties": {
    "manufacturing_capability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "manufacturing_capability"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^manufacturing_capability\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "actor"
          ]
        },
        "location_id": {
          "type": "string",
          "pattern": "^(location)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "location"
          ]
        },
        "technology_id": {
          "type": "string",
          "pattern": "^(technology)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "technology"
          ]
        },
        "recipe_kind": {
          "enum": [
            "logic",
            "SRAM",
            "DRAM",
            "analogue"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "qualification_requirements": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/item"
          },
          "minItems": 0
        },
        "base_part_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(base_part)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "base_part"
            ]
          }
        },
        "capability_kind": {
          "enum": [
            "recipe",
            "production_line"
          ],
          "description": "Absent means recipe for compatibility. A production line owns shared physical resources; recipes qualify use of them."
        },
        "production_line_id": {
          "type": "string",
          "pattern": "^manufacturing_capability\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "manufacturing_capability"
          ]
        },
        "configuration_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/configuration"
          }
        }
      },
      "required": [
        "id",
        "name",
        "actor_id",
        "technology_id",
        "description",
        "qualification_requirements"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_kind": {
                "const": "production_line"
              }
            },
            "required": [
              "capability_kind"
            ]
          },
          "then": {
            "required": [
              "location_id",
              "configuration_history"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "recipe_kind"
                  ]
                },
                {
                  "required": [
                    "production_line_id"
                  ]
                },
                {
                  "required": [
                    "base_part_ids"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "recipe_kind"
            ],
            "not": {
              "required": [
                "configuration_history"
              ]
            }
          }
        }
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Exclusive cutoff; null means no superseding configuration recorded, not perpetual demonstrated output."
        },
        "equipment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/equipment"
          }
        },
        "technical_specification": {
          "$ref": "https://aion-logix.invalid/schemas/technical.schema.json#/$defs/technical_specification"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/item"
          },
          "minItems": 1
        }
      },
      "required": [
        "version_number",
        "description",
        "effective_from",
        "effective_until",
        "equipment",
        "technical_specification",
        "constraints"
      ],
      "additionalProperties": false
    },
    "equipment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "quantity",
        "description"
      ],
      "additionalProperties": false
    }
  }
}
