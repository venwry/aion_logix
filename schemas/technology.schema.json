{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/technology.schema.json",
  "type": "object",
  "properties": {
    "technology": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "technology"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^technology\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "protocol",
            "interface",
            "architecture",
            "software_method",
            "fabrication"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "related_technology_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(technology)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "technology"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "specification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "fabrication": {
          "type": "object",
          "properties": {
            "feature_size_um": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wafer_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lithography_method": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "feature_size_um",
            "lithography_method"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "owner_actor_ids",
        "related_technology_ids",
        "specification"
      ],
      "additionalProperties": false
    }
  }
}
