{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/assumption.schema.json",
  "type": "object",
  "properties": {
    "assumption": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    },
    "metadata": {
      "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/metadata"
    }
  },
  "required": [
    "assumption",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^assumption\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending confirmation",
            "confirmed",
            "speculation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/source_ref"
          },
          "minItems": 1
        },
        "confirmation": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/confirmation"
        },
        "kind": {
          "type": "string",
          "enum": [
            "world_premise",
            "policy",
            "constraint",
            "target",
            "baseline_condition"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(assumption|actor|actor_relationship|event|campaign|agreement|clause|process|programme|location|narrative_period)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "assumption",
              "actor",
              "actor_relationship",
              "event",
              "campaign",
              "agreement",
              "clause",
              "process",
              "programme",
              "location",
              "narrative_period"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "valid_time": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/period"
        },
        "exception_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(assumption)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "assumption"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "status",
        "source_refs",
        "kind",
        "statement"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmation"
            ]
          }
        }
      ]
    }
  }
}
