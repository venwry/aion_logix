{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/assumption.schema.json",
  "type": "object",
  "properties": {
    "assumption": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "assumption"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^assumption\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "world_premise",
            "policy",
            "constraint",
            "target",
            "baseline_condition"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor|actor_relationship|agreement|assumption|campaign|event|location|manufacturing_capability|market_response|process|product|technology)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor",
              "actor_relationship",
              "agreement",
              "assumption",
              "campaign",
              "event",
              "location",
              "manufacturing_capability",
              "market_response",
              "process",
              "product",
              "technology"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "exception_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(assumption)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "assumption"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "process_id": {
          "type": "string",
          "pattern": "^(process)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "process"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "statement"
      ],
      "additionalProperties": false
    }
  }
}
