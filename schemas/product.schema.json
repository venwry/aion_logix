{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/product.schema.json",
  "type": "object",
  "properties": {
    "product": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "product"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^product\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "computer",
            "hardware",
            "software",
            "software_edition",
            "bundle",
            "service",
            "chip",
            "family"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provider_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "family_product_id": {
          "type": "string",
          "pattern": "^(product)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "product"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "technology_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(technology)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "technology"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "specification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "offering_category": {
          "enum": [
            "computer",
            "computer_software_bundle",
            "expansion_kit",
            "software",
            "computer_system",
            "service"
          ]
        },
        "technical_identity": {
          "$ref": "https://aion-logix.invalid/schemas/composition.schema.json#/$defs/identity"
        },
        "launch_campaign_id": {
          "type": "string",
          "pattern": "^(campaign)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "campaign"
          ]
        },
        "composition_history": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/composition.schema.json#/$defs/product_version"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/technical.schema.json#/$defs/requirement"
          }
        },
        "service_definition": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "entitlements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "service",
                      "licence"
                    ]
                  },
                  "count": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "duration_unit": {
                    "enum": [
                      "day",
                      "month",
                      "year"
                    ]
                  },
                  "agreement_id": {
                    "type": "string",
                    "pattern": "^(agreement)\\.[a-z0-9][a-z0-9_.-]*$",
                    "x-ref": [
                      "agreement"
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "count",
                  "scope"
                ],
                "additionalProperties": false
              }
            },
            "requirements": {
              "type": "array",
              "items": {
                "$ref": "https://aion-logix.invalid/schemas/technical.schema.json#/$defs/requirement"
              }
            }
          },
          "required": [
            "description",
            "entitlements",
            "requirements"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "provider_actor_ids",
        "technology_ids",
        "specification"
      ],
      "additionalProperties": false
    }
  }
}
