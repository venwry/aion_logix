{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/product.schema.json",
  "type": "object",
  "properties": {
    "product": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "product"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^product\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "computer",
            "hardware",
            "software",
            "software_edition",
            "bundle",
            "service",
            "chip",
            "family"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provider_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "number",
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "offering_category": {
          "enum": [
            "computer",
            "computer_software_bundle",
            "expansion_kit",
            "software",
            "computer_system",
            "service",
            "peripheral",
            "software_cartridge"
          ]
        },
        "technical_identity": {
          "$ref": "https://aion-logix.invalid/schemas/composition.schema.json#/$defs/identity"
        },
        "launch_campaign_id": {
          "type": "string",
          "pattern": "^(campaign)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "campaign"
          ],
          "description": "Launch campaign; multiple products may share this campaign and its launch events."
        },
        "composition_history": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/composition.schema.json#/$defs/product_version"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/technical.schema.json#/$defs/requirement"
          }
        },
        "launch_event_id": {
          "type": "string",
          "pattern": "^event\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "event"
          ],
          "description": "Launch event owned by the campaign execution process directly or through subprocesses; may be shared by products."
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "provider_actor_ids",
        "specification"
      ],
      "additionalProperties": false,
      "description": "Logix/AION customer-facing offering. Legacy identities remain accepted during catalogue migration.",
      "dependentRequired": {
        "launch_event_id": [
          "launch_campaign_id"
        ],
        "launch_campaign_id": [
          "launch_event_id"
        ]
      }
    }
  }
}
