{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/product.schema.json",
  "type": "object",
  "properties": {
    "product": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "product"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^product\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "computer",
            "hardware",
            "software",
            "software_edition",
            "bundle",
            "service",
            "chip",
            "family"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provider_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "family_product_id": {
          "type": "string",
          "pattern": "^(product)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "product"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "technology_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(technology)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "technology"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "specification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "provider_actor_ids",
        "technology_ids",
        "specification"
      ],
      "additionalProperties": false
    }
  }
}
