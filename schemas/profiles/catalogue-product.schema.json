{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/profiles/catalogue-product.schema.json",
  "description": "Opt-in catalogue closeout profile for a product record. The active foundation contract remains unchanged until migration proposals are authorized.",
  "allOf": [
    {"$ref": "https://aion-logix.invalid/schemas/product.schema.json#/$defs/record"},
    {
      "type": "object",
      "required": ["offering_category", "launch_campaign_id", "launch_event_id"],
      "properties": {
        "kind": {"enum": ["computer", "hardware", "software", "bundle", "service"]},
        "provider_actor_ids": {"type": "array", "minItems": 1},
        "technology_ids": {"type": "array", "maxItems": 0},
        "specification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
              "description": {"type": "string", "pattern": "\\S"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "service"}}},
          "then": {"properties": {"offering_category": {"const": "service"}}},
          "else": {
            "required": ["composition_history"],
            "properties": {
              "offering_category": {"not": {"const": "service"}},
              "composition_history": {"type": "array", "minItems": 1}
            }
          }
        }
      ]
    }
  ]
}
