{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/common.schema.json",
  "$defs": {
    "date": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "month",
            "day"
          ]
        },
        "qualifier": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "enum": [
            "author_selected",
            "historical_source",
            "legacy_scenario",
            "inferred"
          ]
        }
      },
      "required": [
        "value",
        "precision",
        "basis"
      ],
      "additionalProperties": false,
      "x-date": true
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/date"
        },
        "end": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "x-period": true
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(source)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "source"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id"
      ],
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "actor"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor_id",
        "role"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(source)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "source"
          ]
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "record_sha256"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "used_by_pages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "used_by_calculations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "schema_version",
        "used_by_pages",
        "used_by_calculations"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "reference_year": {
          "type": "integer",
          "minimum": 1972
        },
        "basis": {
          "type": "string",
          "enum": [
            "nominal_commitment",
            "planning_provision",
            "actual_expenditure"
          ]
        }
      },
      "required": [
        "value",
        "currency",
        "reference_year",
        "basis"
      ],
      "additionalProperties": false
    }
  }
}
