{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/actor_relationship.schema.json",
  "type": "object",
  "properties": {
    "actor_relationship": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "actor_relationship"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^actor_relationship\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "employment",
            "operating_role",
            "affiliation",
            "control",
            "identity_assumption"
          ]
        },
        "subject_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "object_actor_id": {
          "type": "string",
          "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "actor"
          ]
        },
        "established_by_event_id": {
          "type": "string",
          "pattern": "^(event)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "event"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "process_id": {
          "type": "string",
          "pattern": "^(process)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "process"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "subject_actor_ids",
        "object_actor_id",
        "description"
      ],
      "additionalProperties": false
    }
  }
}
