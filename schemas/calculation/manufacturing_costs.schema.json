{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/calculation/manufacturing_costs.schema.json",
  "type": "object",
  "properties": {
    "model_version": {
      "const": "1.0.0"
    },
    "currency": {
      "const": "USD"
    },
    "currency_basis": {
      "const": "nominal_usd"
    },
    "foundation_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "foundation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assumptions_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "minItems": 1
    },
    "manufacturing_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^product\\.[a-z0-9][a-z0-9_.-]*$"
          },
          "product_name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "computer",
              "hardware",
              "software",
              "bundle",
              "service"
            ]
          },
          "launch_event_id": {
            "type": "string",
            "pattern": "^event\\.[a-z0-9][a-z0-9_.-]*$"
          },
          "launch_date": {
            "type": "string",
            "format": "date"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "estimates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "composition_version": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "total": {
                  "type": "number",
                  "minimum": 0
                },
                "low": {
                  "type": "number",
                  "minimum": 0
                },
                "high": {
                  "type": "number",
                  "minimum": 0
                },
                "breakdown": {
                  "type": "object",
                  "properties": {
                    "purchased_parts": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fabricated_parts": {
                      "type": "number",
                      "minimum": 0
                    },
                    "assembly_test": {
                      "type": "number",
                      "minimum": 0
                    },
                    "factory_overhead": {
                      "type": "number",
                      "minimum": 0
                    },
                    "assembly_loss": {
                      "type": "number",
                      "minimum": 0
                    },
                    "third_party_licensing": {
                      "type": "number",
                      "minimum": 0
                    },
                    "service_delivery": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "purchased_parts",
                    "fabricated_parts",
                    "assembly_test",
                    "factory_overhead",
                    "assembly_loss",
                    "third_party_licensing",
                    "service_delivery"
                  ],
                  "additionalProperties": false
                },
                "route_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "currency_index": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "currency_factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "date",
                "composition_version",
                "total",
                "low",
                "high",
                "breakdown",
                "route_ids",
                "flags",
                "currency_index",
                "currency_factor"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "product_id",
          "product_name",
          "kind",
          "launch_event_id",
          "launch_date",
          "unit",
          "estimates"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "model_version",
    "currency",
    "currency_basis",
    "foundation_revision",
    "foundation_sha256",
    "assumptions_sha256",
    "generated_at",
    "dates",
    "manufacturing_costs"
  ],
  "additionalProperties": false
}
