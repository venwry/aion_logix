{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/software_edition.schema.json",
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(software_edition)\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provider_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          }
        },
        "technology_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(technology)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "technology"
            ]
          }
        },
        "family_product_id": {
          "type": "string",
          "pattern": "^(product)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "product"
          ]
        },
        "family_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "composition_history": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/composition.schema.json#/$defs/software_version"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "provider_actor_ids",
        "technology_ids",
        "family_name",
        "version",
        "edition",
        "composition_history"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "software_edition": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "software_edition"
  ],
  "additionalProperties": false
}
