{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/narrative_period.schema.json",
  "type": "object",
  "properties": {
    "narrative_period": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "narrative_period"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^narrative_period\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/period"
        },
        "display_order": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "period",
        "display_order"
      ],
      "additionalProperties": false
    }
  }
}
