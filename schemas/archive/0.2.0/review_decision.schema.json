{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/review_decision.schema.json",
  "type": "object",
  "properties": {
    "review_decision": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    },
    "metadata": {
      "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/metadata"
    }
  },
  "required": [
    "review_decision",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^review_decision\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending confirmation",
            "confirmed",
            "speculation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/source_ref"
          },
          "minItems": 1
        },
        "confirmation": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/confirmation"
        },
        "source_id": {
          "type": "string",
          "pattern": "^(source)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "source"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "confirm",
            "revise",
            "reject"
          ]
        },
        "target": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record_id": {
                "type": "string",
                "pattern": "^(assumption|actor|actor_relationship|event|campaign|agreement|clause|process|programme|location|narrative_period)\\.[a-z0-9][a-z0-9_.-]*$",
                "x-ref": [
                  "assumption",
                  "actor",
                  "actor_relationship",
                  "event",
                  "campaign",
                  "agreement",
                  "clause",
                  "process",
                  "programme",
                  "location",
                  "narrative_period"
                ]
              },
              "record_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "record_id",
              "record_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "status",
        "source_refs",
        "source_id",
        "decision",
        "target",
        "rationale"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmation"
            ]
          }
        }
      ]
    }
  }
}
