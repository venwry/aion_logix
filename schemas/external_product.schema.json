{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/external_product.schema.json",
  "type": "object",
  "properties": {
    "external_product": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "external_product"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "description": "Descriptive third-party commercial offering; direct role-labelled relationships only. Software rights, technical editions and Logix physical offerings remain separate.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^external_product\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "specification": {
          "$ref": "#/$defs/chapter_list"
        },
        "kind": {
          "enum": [
            "computer",
            "peripheral",
            "software",
            "service",
            "other"
          ]
        },
        "provider_actor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^actor\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          }
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
          "description": "Direct Gregorian date with year, month or day precision; calendar validity checked semantically."
        },
        "impacted_standards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/standard_impact"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "specification",
        "kind",
        "provider_actor_ids"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Plain text with optional {key} substitutions resolved within this chapter."
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^{}]+$"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "number",
        "chapter_name",
        "description",
        "parameters"
      ],
      "additionalProperties": false
    },
    "standard_impact": {
      "type": "object",
      "properties": {
        "standard_id": {
          "type": "string",
          "pattern": "^technology\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "technology"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
          "description": "Direct Gregorian date with year, month or day precision; calendar validity checked semantically."
        },
        "assumption_description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "comparison_description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcomes_description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^{}]+$"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "standard_id",
        "date",
        "assumption_description",
        "comparison_description",
        "outcomes_description",
        "parameters"
      ],
      "additionalProperties": false
    },
    "chapter_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  }
}
