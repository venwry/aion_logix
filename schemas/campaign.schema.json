{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/campaign.schema.json",
  "type": "object",
  "properties": {
    "campaign": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "campaign"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^campaign\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "lead_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "message": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "claim_policy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "launch_event_id": {
          "type": "string",
          "pattern": "^(event)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "event"
          ]
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(product|technology|manufacturing_capability|actor|agreement|market_response)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "product",
              "technology",
              "manufacturing_capability",
              "actor",
              "agreement",
              "market_response"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "presentation": {
          "type": "object",
          "properties": {
            "duration_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "stage": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_minutes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actor_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^actor\\.[a-z0-9][a-z0-9_.-]*$",
                      "x-ref": [
                        "actor"
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "label",
                  "description"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "stage"
          ],
          "additionalProperties": false
        },
        "booth": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "call_to_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "process_id": {
          "type": "string",
          "pattern": "^(process)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "process"
          ]
        },
        "marketing_content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "type",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "lead_actor_ids",
        "process_id"
      ],
      "additionalProperties": false
    }
  }
}
