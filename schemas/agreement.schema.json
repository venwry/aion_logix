{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/agreement.schema.json",
  "type": "object",
  "properties": {
    "agreement": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "agreement"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^agreement\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "founding",
            "employment",
            "licence",
            "supply",
            "distribution",
            "development",
            "cooperation",
            "other"
          ]
        },
        "party": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actor_id": {
                "type": "string",
                "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
                "x-ref": [
                  "actor"
                ]
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actor_id",
              "role"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "offer",
            "negotiating",
            "executed",
            "terminated",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "clauses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clause"
          }
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "party",
        "state",
        "clauses"
      ],
      "additionalProperties": false
    },
    "clause": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^clause\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "equity",
            "funding",
            "rights",
            "responsibility",
            "qualification",
            "term",
            "other",
            "target_equity",
            "target_funding",
            "target_rights",
            "target_responsibility",
            "target_qualification",
            "target_term",
            "target_other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "statement",
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
