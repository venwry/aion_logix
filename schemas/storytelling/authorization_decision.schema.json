{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "authorization_decision": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^authorization_decision\\."
          },
          "action": {
            "enum": [
              "authorize_record",
              "authorize_records",
              "approve_change"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "proposal_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposal": {
            "type": "object"
          },
          "target": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "after": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "content_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "record_id",
                "before",
                "after",
                "content_sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "action",
          "actor",
          "decided_at",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "authorization_decision"
  ],
  "additionalProperties": false
}
