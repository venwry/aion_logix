{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "authorization": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^authorization\\."
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "authorized",
              "unauthorized"
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "record_id",
          "state",
          "content_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "authorization"
  ],
  "additionalProperties": false
}
