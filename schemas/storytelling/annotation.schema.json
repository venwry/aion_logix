{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "annotation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^annotation\\.[a-zA-Z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "supersedes_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "open",
              "resolved",
              "dismissed"
            ]
          },
          "change_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^change\\."
            }
          }
        },
        "required": [
          "id",
          "text",
          "supersedes_id",
          "actor",
          "created_at",
          "record_id",
          "content_sha256",
          "state",
          "change_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "annotation"
  ],
  "additionalProperties": false
}
