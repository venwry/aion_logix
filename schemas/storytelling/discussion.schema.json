{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/storytelling/discussion.schema.json",
  "type": "object",
  "required": ["id", "category", "title", "reason", "elements", "affected_record_ids", "findings"],
  "properties": {
    "id": {"type": "string", "pattern": "^change\\.[a-z0-9_.-]+$"},
    "category": {"const": "discussion"},
    "title": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "elements": {"type": "array", "maxItems": 0},
    "affected_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "findings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["description"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
