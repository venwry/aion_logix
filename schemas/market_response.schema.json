{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/market_response.schema.json",
  "type": "object",
  "properties": {
    "market_response": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    }
  },
  "required": [
    "market_response"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^market_response\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "adoption",
            "partnership",
            "competing_offer",
            "compatibility_response",
            "purchasing_response",
            "channel_response",
            "market_response",
            "other"
          ]
        },
        "respondent_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(actor|agreement|assumption|campaign|event|location|manufacturing_capability|market_response|process|product|technology|base_part|device|software_edition|external_product)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "actor",
              "agreement",
              "assumption",
              "campaign",
              "event",
              "location",
              "manufacturing_capability",
              "market_response",
              "process",
              "product",
              "technology",
              "base_part",
              "device",
              "software_edition",
              "external_product"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "trigger_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(event|process|campaign|agreement)\\.[a-z0-9][a-z0-9_.-]*$",
            "x-ref": [
              "event",
              "process",
              "campaign",
              "agreement"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impacted_standards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/impacted_standard"
          }
        },
        "impacted_products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/impacted_product"
          }
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "respondent_actor_ids",
        "subject_ids",
        "trigger_ids",
        "description"
      ],
      "additionalProperties": false
    },
    "impacted_standard": {
      "type": "object",
      "properties": {
        "standard_id": {
          "type": "string",
          "pattern": "^(technology)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "technology"
          ]
        },
        "direction": {
          "enum": [
            "strengthens",
            "weakens",
            "mixed"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^{}]+$"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "standard_id",
        "direction",
        "description",
        "parameters"
      ],
      "additionalProperties": false
    },
    "impacted_product": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^(product|external_product)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "product",
            "external_product"
          ]
        },
        "direction": {
          "enum": [
            "strengthens",
            "weakens",
            "mixed"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^{}]+$"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "product_id",
        "direction",
        "description",
        "parameters"
      ],
      "additionalProperties": false
    }
  }
}
