{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/process.schema.json",
  "type": "object",
  "properties": {
    "process": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    },
    "metadata": {
      "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/metadata"
    }
  },
  "required": [
    "process",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^process\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending confirmation",
            "confirmed",
            "speculation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/source_ref"
          },
          "minItems": 1
        },
        "confirmation": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/confirmation"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "study",
            "development",
            "recruitment",
            "transfer",
            "qualification",
            "preparation",
            "other"
          ]
        },
        "period": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/period"
        },
        "participant": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/participant"
          },
          "minItems": 0
        },
        "parent_process_id": {
          "type": "string",
          "pattern": "^(process)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "process"
          ]
        },
        "programme_id": {
          "type": "string",
          "pattern": "^(programme)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "programme"
          ]
        },
        "step": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "event_id": {
                "type": "string",
                "pattern": "^event\\.[a-z0-9][a-z0-9_.-]*$",
                "x-ref": [
                  "event"
                ]
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "completion_state": {
          "type": "string",
          "enum": [
            "planned",
            "in_progress",
            "completed",
            "cancelled",
            "unknown"
          ]
        },
        "acceptance_gate": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence_event_id": {
                "type": "string",
                "pattern": "^(event)\\.[a-z0-9][a-z0-9_.-]*$",
                "x-ref": [
                  "event"
                ]
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "status",
        "source_refs",
        "title",
        "kind",
        "completion_state",
        "participant"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmation"
            ]
          }
        }
      ]
    }
  }
}
