              "impacted_standards": [
                {
                  "standard_id": "technology.flexibus",
                  "date": "1979-12-31",
                  "assumption_description": "Assess {historical_product} in its recorded {host} configuration. Treat the keyboard’s handshaking signals as its native electrical interface.",
                  "comparison_description": "It lacks the FlexiBUS transport and device-description protocol; a separately engineered controller would be needed. The relationship concerns alternative complete configurations, not proven direct compatibility with this standard.",
                  "outcomes_description": "The low-complexity native route can compete for custom-system builders, while cross-host reuse remains conditional on a real FlexiBUS implementation.",
                  "parameters": [
                    {
                      "key": "historical_product",
                      "value": "Netronics Professional ASCII Keyboard"
                    },
                    {
                      "key": "host",
                      "value": "ELF II and suitably interfaced micros"
                    }
                  ],
                  "relationship": "competes_with"
                }
              ],
              "impacted_products": [
                {
                  "product_id": "product.device_flexibus_keyboard",
                  "relationship": "competes_with",
                  "date": "1979-12-31",
                  "assumption_description": "Assess the recorded {host} configuration with its required controller, cabling and software. Upper/lowercase ASCII, parity options and selectable handshaking.",
                  "comparison_description": "The alternative is a FlexiBUS keyboard, not a complete terminal. Compare a working console including host, display and interface; a conventional keyboard or terminal is not directly attachable through the keyboard device protocol. The canonical implementation is {implementation}.",
                  "outcomes_description": "This ASCII keyboard is a conventional input alternative for custom hosts, but does not supply the Logix connector, discovery contract or guaranteed full navigation/modifier event set. This is a conditional purchase-path assessment, not evidence of measured market share or superior performance.",
                  "parameters": [
                    {
                      "key": "host",
                      "value": "ELF II and suitably interfaced micros"
                    },
                    {
                      "key": "implementation",
                      "value": "device.flexibus_keyboard"
                    }
                  ]
                }
              ]
            }
