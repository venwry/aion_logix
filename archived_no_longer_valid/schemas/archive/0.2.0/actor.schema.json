{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/actor.schema.json",
  "type": "object",
  "properties": {
    "actor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    },
    "metadata": {
      "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/metadata"
    }
  },
  "required": [
    "actor",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^actor\\.[a-z0-9][a-z0-9_.-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending confirmation",
            "confirmed",
            "speculation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/source_ref"
          },
          "minItems": 1
        },
        "confirmation": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/confirmation"
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "organisation",
            "group"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "status",
        "source_refs",
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmation"
            ]
          }
        }
      ]
    }
  }
}
