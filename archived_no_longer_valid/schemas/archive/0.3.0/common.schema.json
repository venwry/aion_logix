{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-logix.invalid/schemas/common.schema.json",
  "$defs": {
    "date": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(19[7-9][0-9]|[2-9][0-9]{3})(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "month",
            "day"
          ]
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "additionalProperties": false,
      "x-date": true
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/date"
        },
        "end": {
          "$ref": "https://aion-logix.invalid/schemas/common.schema.json#/$defs/date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "x-period": true
    },
    "participant": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^(actor)\\.[a-z0-9][a-z0-9_.-]*$",
          "x-ref": [
            "actor"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "actor_id",
        "role"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "reference_year": {
          "type": "integer",
          "minimum": 1972
        },
        "basis": {
          "type": "string",
          "enum": [
            "nominal_commitment",
            "planning_provision",
            "actual_expenditure"
          ]
        }
      },
      "required": [
        "value",
        "currency",
        "reference_year",
        "basis"
      ],
      "additionalProperties": false
    }
  }
}
