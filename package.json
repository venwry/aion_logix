{
  "name": "aion_logix",
  "version": "1.0.0",
  "description": "Structured alternative history, author review and timeline browser",
  "scripts": {
    "build": "esbuild assets/main.js --bundle --format=esm --splitting --outdir=assets --entry-names=app --chunk-names=chunks/[name]-[hash] --minify",
    "start": "node server/index.js",
    "test": "playwright test",
    "validate:model": "node tools/validate-model.js",
    "test:model": "node --test tests/model/*.test.js",
    "validate:data": "node tools/validate-foundation.js",
    "test:migration": "node --test tests/migration/*.test.js",
    "preview": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test:server": "node --test tests/server/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venwry/aion_logix.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/venwry/aion_logix/issues"
  },
  "homepage": "https://github.com/venwry/aion_logix#readme",
  "private": true,
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
